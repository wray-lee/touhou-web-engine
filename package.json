{
  "name": "@uestc-touhou/touhou-web-engine",
  "version": "0.1.0",
  "description": "A modern, extensible STG engine for Touhou Project in the browser",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./th08": {
      "import": "./dist/games/th08/index.js",
      "types": "./dist/games/th08/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "assets:th08": "node tools/th08/extract.mjs",
    "anm:th08": "node tools/th08/anm/generate.mjs",
    "anm:effects": "node tools/th08/anm/generate-effects.mjs",
    "ecl:th08": "node --import ./tools/th08/ecl/register.mjs tools/th08/ecl/generate.mjs",
    "ecl:check": "node --import ./tools/th08/ecl/register.mjs tools/th08/ecl/check.mjs",
    "ecl:trace": "node --import ./tools/th08/ecl/register.mjs tools/th08/ecl/trace.mjs",
    "build": "vite build && tsc -p tsconfig.build.json",
    "ci": "npm run typecheck && npm run lint && npm run test",
    "deploy": "gh-pages -d dist",
    "dev": "vite",
    "format": "prettier --write \"src/**/*.{ts,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,json,md}\"",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "touhou",
    "stg",
    "danmaku",
    "game-engine",
    "pixijs",
    "typescript"
  ],
  "author": "UESTC Gensokyo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wray-lee/touhou-web-engine.git"
  },
  "dependencies": {
    "pixi.js": "^8.6.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "eslint": "^9.17.0",
    "gh-pages": "^6.3.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "bun@1.4.0"
}
